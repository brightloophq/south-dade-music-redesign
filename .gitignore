# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never get committed.
# The template is the one deliberate exception: it documents every variable the
# project reads, with no values in it.
.env*
!.env.example

# storybook build output — a generated artifact, not source
storybook-static

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
