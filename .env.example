# South Dade Music — environment template
#
# Copy to `.env.local` and fill in. `.env*` is git-ignored (see .gitignore),
# so `.env.local` is never committed.
#
# ⚠️ Never prefix a secret with NEXT_PUBLIC_ — that inlines the value into the
#    browser bundle. See node_modules/next/dist/docs/01-app/02-guides/environment-variables.md

# ---------------------------------------------------------------------------
# Image generation (development only)
# ---------------------------------------------------------------------------
# Used by `npm run generate:image`. Server-side only; never sent to the client.
# The script refuses to run if a NEXT_PUBLIC_*GEMINI* key exists.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin for metadata, OG tags and the sitemap.
# Defaults to https://www.southdademusic.com when unset.
NEXT_PUBLIC_SITE_URL=

# Indexing is OFF unless this is exactly "true", so no preview or staging
# deployment can be indexed by accident. Set deliberately at launch.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Motion diagnostics — DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# Renders the live motion debug panel and exposes window.__MOTION_DIAGNOSTICS__
# for `npm run probe:motion`.
#
# Safe by construction: the panel is additionally gated on
# `NODE_ENV !== 'production'`, so a production build strips it even if this is
# left set to true — verified in docs/implementation/motion-runtime-diagnosis.md.
#
# Leave it false/unset for anything deployed.
NEXT_PUBLIC_MOTION_DEBUG=false
